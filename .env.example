# Car-Dealership independent local DEVELOPMENT defaults only. Never copy Optimum secrets.
APP_ENV=local
APP_PROJECT_ID=car-dealership
EXPECTED_DATABASE_HOST=localhost
EXPECTED_DATABASE_NAME=car_dealership_dev
POSTGRES_DB=car_dealership_dev
POSTGRES_USER=car_dealership_dev
POSTGRES_PASSWORD=replace_with_unique_local_password
POSTGRES_PORT=5436
DATABASE_URL=postgresql://car_dealership_dev:replace_with_unique_local_password@localhost:5436/car_dealership_dev?schema=public
DIRECT_URL=postgresql://car_dealership_dev:replace_with_unique_local_password@localhost:5436/car_dealership_dev?schema=public

# Generate UNIQUE secrets for each Car-Dealership environment.
AUTH_SECRET=
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# All outbound communication remains CAPTURED / DISABLED during Phase 0.
EMAIL_DELIVERY_MODE=capture
RESEND_API_KEY=
AUTH_FROM_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
LEAD_NOTIFICATION_EMAIL=
NEXT_PUBLIC_PRIMARY_PHONE=
NEXT_PUBLIC_SECONDARY_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Local image storage only for development. Set distinct isolated buckets later.
IMAGE_STORAGE_DRIVER=local
PRIVATE_STORAGE_DRIVER=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
